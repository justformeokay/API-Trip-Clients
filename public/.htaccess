Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Handle Authorization header (some Apache setups strip it)
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect all requests to index.php (except existing files/dirs)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L,QSA]
</IfModule>

# Disable directory listing
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Security headers (supplement middleware headers)
<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# Deny access to sensitive files
<FilesMatch "\.(env|json|lock|md|sql|sh|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>
